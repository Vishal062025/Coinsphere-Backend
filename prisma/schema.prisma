generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role?    @default(USER)
  dob       String
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime @default(now())

  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  rootReferralId String?
  referralCount  Int     @default(0) // Direct referrals
  teamSize       Int     @default(0) // Total team under this user

  payments     Payment[]
  rewards      Reward[]
  rewardData   RewardData?
  claimRewards ClaimReward[] @relation("UserClaimRewards")

  referralTreeRoots    ReferralTree[]       @relation("RootRef")
  referralTreeChildren ReferralTree[]       @relation("ChildRef")
  assignedTokens       AssignTokenHistory[] @relation("TokenAssignments")
  receivedTokens       AssignTokenHistory[] @relation("TokenRecipients")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model ReferralTree {
  id      String @id @default(uuid())
  rootId  String
  childId String
  depth   Int // 1 for direct, 2 for indirect...
  path    String // Optional: can be used to trace lineage

  root  User @relation("RootRef", fields: [rootId], references: [id])
  child User @relation("ChildRef", fields: [childId], references: [id])
}

model Payment {
  id                 String              @id @default(uuid())
  amount             Float
  cryptoType         String
  transactionHash    String              @unique
  isCompleted        Boolean             @default(false)
  isActive           Boolean             @default(true)
  isExecuted         Boolean             @default(true)
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  createdAt          DateTime            @default(now())
  token              Token?
  userWalletAddress  String?
  AssignTokenHistory AssignTokenHistory?
}

model Token {
  id           String @id @default(uuid())
  paymentId    String @unique
  token        Float // amount
  ercHash      String @unique
  currentPrice Float

  payment Payment @relation(fields: [paymentId], references: [id])
}

model AssignTokenHistory {
  id              String   @id @default(uuid())
  adminId         String
  admin           User     @relation(name: "TokenAssignments", fields: [adminId], references: [id])
  recipientId     String
  recipient       User     @relation(name: "TokenRecipients", fields: [recipientId], references: [id])
  tokenAmount     Float
  usdtEquivalent  Float
  transactionHash String
  status          String?  @default("COMPLETED") // pending, completed, failed
  paymentId       String?  @unique
  payment         Payment? @relation(fields: [paymentId], references: [id])
  createdAt       DateTime @default(now())
}

model Reward {
  id                  String  @id @default(uuid())
  userId              String
  rewardById          String
  referralPurchaseCSP Float
  rewardCSP           Float
  isTeamReward        Boolean @default(false)
  isCompleted         Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id])
}

model RewardData {
  id         String @id @default(uuid())
  userId     String @unique
  claimedCSP Float
  user       User   @relation(fields: [userId], references: [id])
}

model ClaimReward {
  id                String                     @id @default(uuid())
  userId            String
  rewardCSP         Float
  userWalletAddress String
  createdAt         DateTime                   @default(now())
  status            ClaimStatus                @default(pending)
  user              User                       @relation("UserClaimRewards", fields: [userId], references: [id])
  rewardHistory     ClaimedTokenRewardHistory?
}

enum ClaimStatus {
  pending
  approved
  cancelled
}

model ClaimedTokenRewardHistory {
  id            String   @id @default(uuid())
  claimRewardId String   @unique
  usdtAmount    Float
  usdtTxHash    String   @unique
  cspAmount     Float
  cspTxHash     String   @unique
  createdAt     DateTime @default(now())

  claimReward ClaimReward @relation(fields: [claimRewardId], references: [id])
}
